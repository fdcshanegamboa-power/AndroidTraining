<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    android:padding="10dp">

    <!-- Thumbnail -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_thumbnail"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/image_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Photo thumbnail"
            android:background="#E0E0E0" />

    </androidx.cardview.widget.CardView>

    <!-- Photo filename / title -->
    <TextView
        android:id="@+id/text_photo_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="photo_name.jpg"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/card_thumbnail"
        app:layout_constraintStart_toEndOf="@id/card_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/button_delete" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/text_photo_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mar 16, 2026 · 10:24 AM"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_photo_name"
        app:layout_constraintStart_toEndOf="@id/card_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/button_delete" />

    <!-- Subtle delete button -->
    <ImageButton
        android:id="@+id/button_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>